# Copy to .env (ignored by git) before the first launch.

# Database: read by Docker Compose only once, when the database volume is created.
DB_NAME=datashare
DB_USER=datashare
DB_PASSWORD=change-me

# JWT signing key (HS256): at least 32 characters. Generate one with: openssl rand -base64 32
JWT_SECRET=change-me-with-openssl-rand-base64-32
