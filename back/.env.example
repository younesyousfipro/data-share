# Copy to .env (ignored by git) before the first launch.

# Database: read by Docker Compose only once, when the database volume is created.
DB_NAME=datashare
DB_USER=datashare
DB_PASSWORD=change-me

# JWT signing key (HS256): at least 32 characters. Generate one with: openssl rand -base64 32
JWT_SECRET=change-me-with-openssl-rand-base64-32

# Optional: where uploaded files are stored (default: back/uploads)
# STORAGE_DIRECTORY=uploads

# Optional: where the JSON log file is written (default: back/logs/datashare.log)
# LOG_FILE=logs/datashare.log

# Optional: when expired files are removed from disk (default: every hour).
# Once a day at 3 am, for a server that never stops:
# PURGE_CRON=0 0 3 * * *
